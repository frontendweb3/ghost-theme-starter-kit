<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    {{> "hmr"}}
    {{> "style-script"}} {{!-- partials/style-script.hbs --}}

    {{ghost_head}}

</head>

<body class="{{body_class}} bg-background text-foreground antialiased transition-colors duration-300">

    <div class="flex flex-col min-h-screen">

        {{> "header"}}

        <main class="grow">
            {{{body}}}
        </main>

        {{> "footer"}}

    </div>

    {{ghost_foot}}

</body>

</html>